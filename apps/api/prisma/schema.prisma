generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

// Phase 0: minimal placeholder so migrations run.
// Full schema (users, bookings, availability exclusion constraints) = Phase 1.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

enum Role {
  TRAVELER
  VENDOR
  GUIDE
  ADMIN
  SUPER_ADMIN
}

enum VendorType {
  HOTEL
  VEHICLE
  BOTH
}

enum VerifiedStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                    String         @id @default(uuid())
  phone                 String?        @unique
  email                 String?        @unique
  passwordHash          String?        @map("password_hash")
  fullName              String?        @map("full_name")
  vendorType            VendorType?    @map("vendor_type")
  verifiedStatus        VerifiedStatus @default(PENDING) @map("verified_status")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  commissionRatePercent Int            @default(10) @map("commission_rate_percent")
  suspendedAt           DateTime?      @map("suspended_at")
  suspensionReason      String?        @map("suspension_reason")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  ownedHotels   Hotel[]
  ownedVehicles Vehicle[]

  adminAuditLogsAsActor AdminAuditLog[]     @relation("AdminAuditActor")
  vendorLedgerEntries   VendorLedgerEntry[]

  @@map("users")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum BookableType {
  ROOM
  VEHICLE
}

enum VehicleCategory {
  CNG
  JEEP
  BOAT
}

enum BookingStatus {
  HELD
  CONFIRMED
  CHECKED_IN
  COMPLETED
  AUTO_CANCELLED
  CANCELLED
  REFUNDED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum LedgerEntryType {
  GROSS_PAYMENT
  PLATFORM_FEE
  VENDOR_OWED
}

enum District {
  DHAKA
  CHATTOGRAM
  COXS_BAZAR
  RANGAMATI
  BANDARBAN
  KHAGRACHARI
  SYLHET
  SREEMANGAL
  SAINT_MARTIN
  KHULNA
  SUNDARBANS
  RAJSHAHI
  BARISHAL
  RANGPUR
  MYMENSINGH
  JESSORE
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  SUITE
  FAMILY
  DORMITORY
}

enum BedType {
  SINGLE
  TWIN
  DOUBLE
  QUEEN
  KING
  BUNK
}

enum FacilityCatalog {
  TRAVEL_DESK
  BATHTUB
  LAUNDRY_SERVICE
  WELCOME_DRINKS
  THEMED_NIGHTS
  ELEVATOR
  SMOKE_FREE
  SWIMMING_POOL
  PARKING
  GYM
  RESTAURANT
  ROOM_SERVICE
  WIFI
  AIR_CONDITIONING
  GENERATOR_BACKUP
  CCTV
}

model Hotel {
  id           String            @id @default(uuid())
  ownerId      String            @map("owner_id")
  name         String
  city         District
  address      String
  description  String?
  amenities    FacilityCatalog[]
  starRating   Int?              @map("star_rating")
  checkInTime  String            @map("check_in_time")
  checkOutTime String            @map("check_out_time")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  owner  User         @relation(fields: [ownerId], references: [id])
  rooms  Room[]
  photos HotelPhoto[]

  @@map("hotels")
}

model Room {
  id                 String   @id @default(uuid())
  hotelId            String   @map("hotel_id")
  roomType           RoomType @map("room_type")
  pricePerNightMinor Int      @map("price_per_night_minor")
  currency           String   @default("BDT")
  capacity           Int
  hasAC              Boolean  @map("has_ac")
  bedType            BedType  @map("bed_type")
  amenities          String[]
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  hotel  Hotel       @relation(fields: [hotelId], references: [id])
  photos RoomPhoto[]

  vendorLedgerEntries VendorLedgerEntry[]

  @@map("rooms")
}

model Vehicle {
  id               String          @id @default(uuid())
  ownerId          String          @map("owner_id")
  category         VehicleCategory
  city             District
  model            String?
  capacity         Int
  pricePerDayMinor Int             @map("price_per_day_minor")
  currency         String          @default("BDT")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id])

  vendorLedgerEntries VendorLedgerEntry[]

  @@map("vehicles")
}

enum AdminActionType {
  VENDOR_APPROVED
  VENDOR_REJECTED
  VENDOR_RESUBMITTED
  VENDOR_SUSPENDED
  VENDOR_UNSUSPENDED
  COMMISSION_RATE_CHANGED
  BOOKING_FORCE_CANCELLED
  TRAVELER_SUSPENDED
  TRAVELER_UNSUSPENDED
}

model AdminAuditLog {
  id        String          @id @default(uuid())
  actorId   String          @map("actor_id")
  /// Polymorphic identifier: a User.id for vendor-targeted actions
  /// (VENDOR_*, COMMISSION_RATE_CHANGED), a Booking.id for
  /// BOOKING_FORCE_CANCELLED. No DB-level FK because it can reference
  /// either table depending on `action`.
  targetId  String          @map("target_id")
  action    AdminActionType
  reason    String?
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at")

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id])

  @@index([targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model HotelPhoto {
  id        String   @id @default(uuid())
  hotelId   String   @map("hotel_id")
  objectKey String   @map("object_key")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_photos")
}

model RoomPhoto {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  objectKey String   @map("object_key")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_photos")
}

model Booking {
  id               String                   @id @default(uuid())
  userId           String?                  @map("user_id")
  bookableType     BookableType             @map("bookable_type")
  roomId           String?                  @map("room_id")
  vehicleId        String?                  @map("vehicle_id")
  resourceOwnerId  String                   @map("resource_owner_id")
  dateRange        Unsupported("daterange") @map("date_range")
  guestCount       Int?                     @map("guest_count")
  totalAmountMinor Int                      @map("total_amount_minor")
  currency         String                   @default("BDT")
  status           BookingStatus            @default(HELD)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  paymentStatus    PaymentStatus            @default(PENDING) @map("payment_status")
  gatewayTranId    String?                  @unique @map("gateway_tran_id")
  gatewayValId     String?                  @map("gateway_val_id")
  vendorOwedMinor  Int?                     @map("vendor_owed_minor")
  source           BookingSource            @default(ONLINE) @map("source")

  ledgerEntries       LedgerEntry[]
  vendorLedgerEntries VendorLedgerEntry[]

  @@index([userId])
  @@index([resourceOwnerId])
  @@map("bookings")
}

model LedgerEntry {
  id                 String          @id @default(uuid())
  bookingId          String          @map("booking_id")
  type               LedgerEntryType
  amountMinor        Int             @map("amount_minor")
  ratePercentApplied Int             @map("rate_percent_applied")
  createdAt          DateTime        @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, type])
  @@index([bookingId])
  @@map("ledger_entries")
}

enum LedgerDirection {
  INCOME
  EXPENSE
}

enum VendorLedgerCategory {
  WALK_IN_BOOKING
  MAINTENANCE
  SALARY
  UTILITY
  OTHER
}

enum BookingSource {
  ONLINE
  OFFLINE
}

model VendorLedgerEntry {
  id          String               @id @default(uuid())
  vendorId    String               @map("vendor_id")
  roomId      String?              @map("room_id")
  vehicleId   String?              @map("vehicle_id")
  bookingId   String?              @map("booking_id")
  direction   LedgerDirection
  category    VendorLedgerCategory
  amountMinor Int                  @map("amount_minor")
  note        String?
  entryDate   DateTime             @map("entry_date")
  deletedAt   DateTime?            @map("deleted_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  vendor  User     @relation(fields: [vendorId], references: [id])
  room    Room?    @relation(fields: [roomId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([vendorId, entryDate])
  @@index([roomId])
  @@index([vehicleId])
  @@index([bookingId])
  @@map("vendor_ledger_entries")
}
