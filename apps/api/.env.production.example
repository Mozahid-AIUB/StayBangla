# Production environment for the API.
#
# Copy this to `.env.production` and fill it in. That file is gitignored and
# must stay that way — it carries the database password and the cron secret.
#
# Do not paste these values into a chat, an issue, or a commit message. A
# credential that has been written down somewhere it can be searched is a
# credential that has to be rotated.

# ── Database ────────────────────────────────────────────────────────────────
# Neon → your project → Connect → copy the connection string.
# Take the **pooled** one (the host contains `-pooler`) unless you have a
# reason not to: Cloud Run starts a fresh container per cold start, and
# without pooling those connections pile up against Neon's limit.
# Keep `?sslmode=require` on the end.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# ── Redis ───────────────────────────────────────────────────────────────────
# Upstash → your database → copy the `rediss://` URL. Still needed for OTP
# storage and rate limiting; it no longer holds booking deadlines.
#
# The scheme must be `rediss://`, with two s. Upstash requires TLS, and the
# plain `redis://` URL shown next to the redis-cli example connects without it
# — the client then hangs or is dropped, with nothing that names TLS as the
# cause.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Prepended to every key. Set this whenever the Upstash database is shared
# with another project — the free tier allows only one database per account,
# so sharing is the normal case rather than the exception.
#
# Without it the collisions are silent and specific: OTP codes are stored at
# `otp:<channel>:<identifier>`, and any other app using the same obvious name
# would overwrite a login code mid-verification. Keep the trailing colon.
REDIS_KEY_PREFIX=staybangla:

# ── Scheduled sweeps ────────────────────────────────────────────────────────
# The shared secret the cron sends in `x-cron-secret`. Without it the sweep
# endpoint answers 503 rather than standing open — a route that cancels
# bookings must not be public because nobody configured it.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate each of these separately. Reusing one secret for both means a leak
# of either lets an attacker mint the other kind of token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Web origin ──────────────────────────────────────────────────────────────
# The static site calls this API from the visitor's browser, so the origin has
# to be allowed explicitly or every request is blocked by CORS.
CORS_ORIGINS=https://staybangla.mozahidislam343.workers.dev

# ── Payments ────────────────────────────────────────────────────────────────
# SSLCommerz live credentials. Leave the sandbox values in place until real
# money is meant to move.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ── OTP hashing ─────────────────────────────────────────────────────────────
# Mixed into the OTP hash before storage, so a dump of Redis does not hand
# over working login codes. Required, minimum 32 characters here (the schema
# demands 16; there is no reason to sit at the floor).
#
# Changing it invalidates every OTP currently in flight — harmless, but it
# means anyone mid-login has to request a new code.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PEPPER=

# ── Object storage ──────────────────────────────────────────────────────────
# Hotel and room photographs, uploaded by vendors. These names say MINIO
# because that is what the storage service reads (common/storage/
# minio-storage.service.ts) — the client, not the destination. R2 is
# S3-compatible, so it answers the same client.
#
# For R2, take the endpoint from Cloudflare → R2 → Manage API tokens, and use
# the **host only**: no https:// prefix and no bucket on the end. Port 443
# with SSL, because the endpoint is public internet rather than a container
# on the same network.
MINIO_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=staybangla-uploads
