DATABASE_URL=postgresql://staybangla:staybangla@localhost:5432/staybangla?schema=public
REDIS_URL=redis://127.0.0.1:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=staybangla
S3_SECRET_KEY=staybangla-secret
S3_BUCKET=staybangla-media
S3_REGION=us-east-1
API_PORT=3001
# JWT (generate real secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-32-characters-minimum-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-32-characters-minimum-please
JWT_REFRESH_EXPIRES_IN=30d
# OTP (defaults shown; override as needed)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_IDENTIFIER_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_HOUR=10
OTP_PEPPER=change-me-16-characters-minimum
# Argon2id (defaults shown)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
# Booking (defaults shown)
BOOKING_HOLD_MINUTES=15
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
# Must be literally "true" or "false" (not 1/0/yes/no) — see env.validation.ts
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=staybangla
MINIO_SECRET_KEY=staybangla-secret
MINIO_BUCKET=staybangla-photos
PRESIGNED_URL_EXPIRY_SECONDS=300
