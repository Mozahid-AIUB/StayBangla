# Postgres (matches infra/docker/docker-compose.yml). 127.0.0.1 (not localhost) avoids
# Prisma's IPv6 resolution issue on Windows/Docker Desktop.
DATABASE_URL=postgresql://staybangla:staybangla@127.0.0.1:5432/staybangla?schema=public
# Redis (BullMQ + OTP rate-limit later). Host port 6380 to avoid local Redis clashes.
REDIS_URL=redis://127.0.0.1:6380
# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=staybangla
S3_SECRET_KEY=staybangla-secret
S3_BUCKET=staybangla-media
S3_REGION=us-east-1
# API
API_PORT=3001
# JWT (generate real secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-32-characters-minimum-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-32-characters-minimum-please
JWT_REFRESH_EXPIRES_IN=30d
# OTP (defaults shown; override as needed)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_IDENTIFIER_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_HOUR=10
OTP_PEPPER=change-me-16-characters-minimum
# Argon2id (defaults shown)
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
