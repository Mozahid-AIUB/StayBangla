# Postgres (matches infra/docker/docker-compose.yml). 127.0.0.1 (not localhost) avoids
# Prisma's IPv6 resolution issue on Windows/Docker Desktop.
DATABASE_URL=postgresql://staybangla:staybangla@127.0.0.1:5432/staybangla?schema=public
# Redis (BullMQ + OTP rate-limit later). Host port 6380 to avoid local Redis clashes.
REDIS_URL=redis://127.0.0.1:6380
# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=staybangla
S3_SECRET_KEY=staybangla-secret
S3_BUCKET=staybangla-media
S3_REGION=us-east-1
# API
API_PORT=3001
# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
