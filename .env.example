# Postgres (matches infra/docker/docker-compose.yml)
DATABASE_URL=postgresql://staybangla:staybangla@localhost:5432/staybangla?schema=public
# Redis (BullMQ + OTP rate-limit later)
REDIS_URL=redis://localhost:6379
# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=staybangla
S3_SECRET_KEY=staybangla-secret
S3_BUCKET=staybangla-media
S3_REGION=us-east-1
# API
API_PORT=3001
# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
